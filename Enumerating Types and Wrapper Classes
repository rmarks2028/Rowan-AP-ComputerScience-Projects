package enumeratedtypeandwrapperassignment;

/**
 *
 * @author RMarks2028
 */
import java.util.Scanner;

public class EnumeratedTypeandWrapperAssignment {

    // 1a) Enumeration of the days of the week
    enum Day {MONDAY,TUESDAY,WEDNESDAY,THURSDAY,FRIDAY,SATURDAY,SUNDAY
    }

    // 1b) Enumeration of the months of the year
    enum Month {JANUARY,FEBRUARY,MARCH,APRIL,MAY,JUNE,JULY,AUGUST,SEPTEMBER,OCTOBER,NOVEMBER,DECEMBER
    }

    public static void main(String[] args) {

        // 1a) Print the days with numbers 1-7
        System.out.println("Days of the week:");

        Day[] days = Day.values();

        for (int i = 0; i < days.length; i++) {
            System.out.println((i + 1) + ": " + days[i]);
        }

        System.out.println();

        // 1b) Print the months with numbers 1-12
        System.out.println("Months of the year:");

        Month[] months = Month.values();

        for (int i = 0; i < months.length; i++) {
            System.out.println((i + 1) + ": " + months[i]);
        }

        System.out.println();

        // 2) Ask for CCHS username
        Scanner scan = new Scanner(System.in);

        System.out.print("Enter your CCHS username (including graduation year): ");
        String username = scan.nextLine();

        // The last 4 characters are the graduation year
        String yearString = username.substring(username.length() - 4);

        // Convert the String year into an int
        Integer graduationYear = Integer.parseInt(yearString);

        // Print the graduation year
        System.out.println("Your graduation year is: " + graduationYear);

        // Print the year after graduation
        System.out.println("The year after your graduation year will be: "
                + (graduationYear + 1));

        // Convert graduation year to binary
        String binaryYear = Integer.toBinaryString(graduationYear);

        System.out.println("In binary, you graduate in: "
                + binaryYear);

        scan.close();
    }
}



