package moreloops;

/**
 *
 * @author RMarks2028
 */
public class MoreLoops {
 public static void main(String[] args)
    {
        final int MAX_ROWS = 10;
        System.out.println("(a)");
        //for each row
        for (int row = 1; row <= MAX_ROWS; row++)
        {
            //print out the appropriate number of stars for that row
            for (int star = 10; star >= row; star--){
                System.out.print("*");
            }
            //newline for a new row
            System.out.println();
        }
        System.out.println("(b)");
        for(int row = 1; row <= MAX_ROWS; row++)
        {
            //adding spaces before a star so the stars are moved to the other side
            for(int space = 9; space >= row; space--){
                System.out.print(" ");
            }
            for(int star = 1; star <= row; star++){
                System.out.print("*");
                
            }
            System.out.println();
        }
        System.out.println("(c)");
        for(int row = 1; row<= MAX_ROWS; row++)
        {
            
            for(int space = 2; space <= row; space++){
                System.out.print(" ");
            }
            for(int star = 10; star >= row; star--){
                System.out.print("*");
            }
            System.out.println();
        }
        System.out.println("(d)");
        final int maxRowsD = 5;
        for(int row =1; row<=maxRowsD;row++)
        {
            for(int space = 4; space >= row; space--){
                System.out.print(" ");
            }
            for(int star = 1; star<= row; star++){
                System.out.print("*");
            }
            for(int star = 2; star<= row; star++){
                System.out.print("*");
            }
            System.out.println();
        }
        for(int row = 0; row<=maxRowsD;row++){
            for(int space = 0; space < row; space++){
                System.out.print(" ");
            }
            for (int star = 4; star >= row; star--){
                System.out.print("*");
            }
            for(int star = 3; star >= row; star--){
                System.out.print("*");
            }
            System.out.println();
        }
    }
}
